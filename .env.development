# Локальная разработка против задеплоенного бэкенда (вход через Google, данные с сервера).
# localhost:3000 добавлен на бэкенде в FRONTEND_ORIGINS, CORS_ALLOWED_ORIGINS и CSRF_TRUSTED_ORIGINS.
VITE_API_URL=https://dashboard.olympic.kg/api

# Заглушка входа без бэкенда: active | pending | denied. Включайте в .env.development.local
VITE_AUTH_MOCK=
