# Базовый URL API (по умолчанию /api). Локально с бэкендом через ngrok:
# VITE_API_URL=https://moral-reasonably-husky.ngrok-free.app/api
VITE_API_URL=

# Заглушка авторизации: active | pending | denied. Пусто — реальный бэкенд
VITE_AUTH_MOCK=
# Роль в заглушке авторизации: R1–R9 (по умолчанию R1). На странице: /login?role=R6
VITE_AUTH_MOCK_ROLE=
