server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # Проверка живости для Coolify
  location = /health {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  # Файлы с хешем в имени — кэшируем навсегда
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Бэкенд на том же домене: cookie сессии и OAuth state живут на dashboard.olympic.kg.
  # BACKEND_URL (например http://<контейнер бэкенда>:8000) подставляется при старте контейнера;
  # имя резолвится в момент запроса через DNS Docker, поэтому nginx стартует и без бэкенда
  location ~ ^/(api/|google$|admin/|static/|openapi\.json$) {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend ${BACKEND_URL};
    proxy_pass $backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 60s;
  }

  # SPA: все остальные пути отдаёт index.html, маршрутизацию делает React Router
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
